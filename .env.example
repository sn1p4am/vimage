# Unsplash API
UNSPLASH_ACCESS_KEY=your_unsplash_key_here

# 阿里百炼 DashScope (LLM)
DASHSCOPE_API_KEY=your_dashscope_key_here
DASHSCOPE_MODEL=deepseek-v4-flash
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_MS=2500
DASHSCOPE_ENABLE_THINKING=false
LLM_MAX_TOKENS=256
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_ENTRIES=1000

# 图片搜索时间预算
UNSPLASH_TIMEOUT_MS=2500
IMAGE_SEARCH_BUDGET_MS=5000
UPSTREAM_COOLDOWN_MS=60000

# 服务配置
PORT=7749
NODE_ENV=production

# Agent 找图接口：服务端只保存 API Key 的 SHA-256，逗号分隔可支持轮换
IMAGE_API_KEY_HASHES=
PUBLIC_BASE_URL=http://localhost:7749
IMAGE_API_RATE_LIMIT=60
IMAGE_API_DAILY_LIMIT=1000
IMAGE_SEARCH_MAX_CONCURRENT=4

# 固定图片链接：redirect 或 proxy；代理模式需先取得 Unsplash 接入许可
IMAGE_DELIVERY_MODE=redirect
UNSPLASH_PROXY_APPROVED=false
IMAGE_PROXY_MAX_CONCURRENT=8
IMAGE_PROXY_TIMEOUT_MS=10000
IMAGE_PROXY_MAX_BYTES=10485760

# 管理后台登录（保护 /dashboard、/dashboard.html、/api/logs）
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SESSION_TTL=43200
ADMIN_COOKIE_SECURE=false
LOG_RETENTION_DAYS=30

# 两级缓存配置（NodeCache L1 + SQLite L2）
CACHE_TTL=43200  # 12小时，单位秒
REDIRECT_CACHE_TTL=43200  # 浏览器/CDN缓存302跳转的时间，单位秒

# 速率限制
UNSPLASH_RATE_LIMIT=4800  # 请按 Unsplash 应用实际获批额度设置

# 数据库
DB_PATH=/data/vimage.db  # Docker内部路径
