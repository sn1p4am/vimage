# Unsplash API
UNSPLASH_ACCESS_KEY=your_unsplash_key_here

# 阿里百炼 DashScope (LLM)
DASHSCOPE_API_KEY=your_dashscope_key_here
DASHSCOPE_MODEL=deepseek-v4-flash
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务配置
PORT=7749
NODE_ENV=production

# Basic Auth（保护 /dashboard、/dashboard.html、/api/logs）
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change_me_to_a_strong_password
BASIC_AUTH_REALM=Vimage

# 缓存配置
CACHE_TTL=43200  # 12小时，单位秒

# 速率限制
UNSPLASH_RATE_LIMIT=4800  # 保守值，避免触碰5000上限

# 数据库
DB_PATH=/data/vimage.db  # Docker内部路径
