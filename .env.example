# Unsplash API
UNSPLASH_ACCESS_KEY=your_unsplash_key_here

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-3-flash-preview

# 服务配置
PORT=7749
NODE_ENV=production

# 缓存配置
CACHE_TTL=43200  # 12小时，单位秒

# 速率限制
UNSPLASH_RATE_LIMIT=4800  # 保守值，避免触碰5000上限

# 数据库
DB_PATH=/data/vimage.db  # Docker内部路径
